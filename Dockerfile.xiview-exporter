FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libxml2-utils \
    && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home appuser
WORKDIR /home/appuser

COPY xiview-exporter/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY xiview-exporter/exporter.py .
COPY xiview-exporter/main.py .

RUN mkdir -p /home/appuser/static /home/appuser/mzId_upload_temp
COPY xiview-server/static/ /home/appuser/static/

RUN chown -R appuser:appuser /home/appuser
USER appuser

EXPOSE 8092
CMD ["python", "main.py"]
